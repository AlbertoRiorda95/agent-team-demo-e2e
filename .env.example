# .env.example: copy to .env (git-ignored) and change the values.
# Read by `docker compose` (compose.yml) and by the services in local
# development. Development placeholders only: never put a real secret here.

# --- NATS (JetStream) ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222
# how the services reach NATS (from the host; inside compose: nats://nats:4222)
NATS_URL=nats://localhost:4222

# --- PostgreSQL 17 (the container) ---
POSTGRES_PORT=5432
POSTGRES_DB=trajectory
POSTGRES_USER=trajectory
POSTGRES_PASSWORD=change-me-local-only

# --- PostgreSQL (how the services connect) ---
# from the host; inside compose: postgresql://postgres:5432/trajectory
# credentials are separate variables, not part of the URL
DATABASE_URL=postgresql://localhost:5432/trajectory
DATABASE_USER=trajectory
DATABASE_PASSWORD=change-me-local-only

# --- store config key (docs/design/persistence.md) ---
# Seals the DB credentials of a store config set (AES-256-GCM): base64 of 32
# random bytes. Generate your own, never commit it:
#   openssl rand -base64 32
# Empty: store still stores trajectories but is `degraded`
# ("STORE_CONFIG_KEY missing or invalid") and rejects sets with credentials.
# Changing it makes the sealed credentials in the store-config volume
# unreadable (store starts `degraded` with the environment credentials): send
# a new set, or drop only that volume with `docker compose rm -sf store &&
# docker volume rm agent-team-demo-e2e_store-config`.
STORE_CONFIG_KEY=

# --- Service ports (AGENTS.md > Commands) ---
API_PORT=8000
VIZ_WEB_PORT=5173
CONTROL_WEB_PORT=5174

# --- Web servers published by compose on 127.0.0.1 (host ports) ---
# in the containers viz-web listens on 3001 and control-web on 5174
VIZ_WEB_SERVER_PORT=3001
CONTROL_WEB_SERVER_PORT=3002
