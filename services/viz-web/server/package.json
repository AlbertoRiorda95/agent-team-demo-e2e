{
  "name": "@trajectory/viz-web-server",
  "version": "0.0.0",
  "private": true,
  "description": "The viz-web server: the API between the viewer UI and NATS / PostgreSQL (server/openapi.yaml).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build:lib": "npm --prefix ../../../libs/trajectory-proto run build",
    "test": "npm run build:lib && vitest run",
    "typecheck": "npm run build:lib && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@albertoriorda95/trajectory-proto": "0.2.0",
    "@bufbuild/protobuf": "2.17.0",
    "@fastify/static": "10.1.12",
    "@nats-io/jetstream": "3.5.0",
    "@nats-io/transport-node": "3.5.0",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.2",
    "vitest": "5.1.1"
  }
}
