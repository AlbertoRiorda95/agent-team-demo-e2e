{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Conan toolchain)",
      "description": "Run `conan install . --build=missing` first: it writes the toolchain used here.",
      "binaryDir": "${sourceDir}/build/Release",
      "toolchainFile": "${sourceDir}/build/Release/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
        "PROPAGATOR_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 60 }
    }
  ]
}
